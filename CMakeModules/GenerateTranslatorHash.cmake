# Hashes the sources that decide what a shader translation looks like and writes the result to
# OUTPUT as a C++ source. Runs as a script on every build; OUTPUT is rewritten only when the hash
# changes.
#   cmake -DSOURCE_ROOT=<repository root> -DOUTPUT=<file> -P GenerateTranslatorHash.cmake

if (NOT SOURCE_ROOT OR NOT OUTPUT)
    message(FATAL_ERROR "GenerateTranslatorHash: SOURCE_ROOT and OUTPUT are required")
endif()

file(GLOB_RECURSE translator_files LIST_DIRECTORIES false
    "${SOURCE_ROOT}/src/shader_recompiler/*.cpp"
    "${SOURCE_ROOT}/src/shader_recompiler/*.h"
    "${SOURCE_ROOT}/src/shader_recompiler/*.inc")
list(APPEND translator_files
    "${SOURCE_ROOT}/src/video_core/shader_environment.cpp"
    "${SOURCE_ROOT}/src/video_core/shader_environment.h"
    "${SOURCE_ROOT}/src/video_core/shader_translation_cache.cpp"
    "${SOURCE_ROOT}/src/video_core/shader_translation_cache.h")
list(SORT translator_files)

set(manifest "")
foreach (translator_file IN LISTS translator_files)
    file(SHA256 "${translator_file}" file_hash)
    file(RELATIVE_PATH relative_path "${SOURCE_ROOT}" "${translator_file}")
    string(APPEND manifest "${relative_path} ${file_hash}\n")
endforeach()

# The SPIR-V emitter library is part of the translator as well.
if (EXISTS "${SOURCE_ROOT}/cpmfile.json")
    file(READ "${SOURCE_ROOT}/cpmfile.json" cpmfile)
    string(JSON sirit_package ERROR_VARIABLE sirit_error GET "${cpmfile}" sirit)
    if (NOT sirit_error)
        string(APPEND manifest "sirit ${sirit_package}\n")
    endif()
endif()

string(SHA256 translator_hash "${manifest}")
set(content "// Generated by CMakeModules/GenerateTranslatorHash.cmake. Do not edit.

namespace VideoCommon::TranslationCache {

extern const char g_translator_source_hash[];
const char g_translator_source_hash[] = \"${translator_hash}\";

} // namespace VideoCommon::TranslationCache
")

set(previous "")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if (NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
